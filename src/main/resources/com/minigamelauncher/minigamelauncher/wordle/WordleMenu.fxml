<AnchorPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" stylesheets="@WordleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minigamelauncher.wordle.WordleMenuController">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Wordle_Main_Menu.png" />
         </image>
      </ImageView>
      <HBox alignment="CENTER" layoutX="439.0" layoutY="464.0" prefHeight="100.0" prefWidth="400.0" AnchorPane.leftAnchor="450.0" AnchorPane.rightAnchor="450.0" AnchorPane.topAnchor="460.0">
         <children>
            <Button id="exitBtn" fx:id="exitBtn" mnemonicParsing="false" onAction="#handleExit" styleClass="basic-btn" text="Exit">
