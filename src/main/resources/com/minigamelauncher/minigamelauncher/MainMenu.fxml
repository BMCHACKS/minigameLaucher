<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="600.0" stylesheets="@MainMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minigamelauncher.MainMenuController">
   <children>
      <ImageView fitHeight="780.0" fitWidth="1282.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Main_Menu_without_Buttons.png" />
         </image>
      </ImageView>
      <VBox alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Button id="startBtn" fx:id="startBtn" mnemonicParsing="false" onAction="#handleStart" styleClass="menu-btn" text="START">
               <font>
                  <Font name="Minecraft" size="27.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="25.0" />
               </VBox.margin>
            </Button>
            <Button id="exitBtn" fx:id="exitBtn" layoutX="990.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleExit" styleClass="menu-btn" text="EXIT">
               <font>
                  <Font name="Minecraft" size="27.0" />
               </font>
            </Button>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <StackPane.margin>
            <Insets right="100.0" top="290.0" />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>
